# PORT=3000 # ローカルでポート競合時のみ指定（既定3000）。Vercelでは不要
GITHUB_CODESPACES_TOKEN=
# ダッシュボードのログイン用パスワード（未設定なら認証なし。Vercelでは環境変数 DASHBOARD_PASSWORD で設定）
DASHBOARD_PASSWORD=
# 監視中（在室）スイッチの状態を保存する GitHub リポジトリへの書き込みトークン。
# 未設定でもダッシュボードは動作するが、監視スイッチの変更（presence.json の更新）ができない。
# Codespace 内の自動停止モニターはこの状態を読んで、不在時かつセッション完了時に自動停止する。
# 権限: opencode-workspace リポジトリへの Contents の読み書き（classic PAT なら repo、fine-grained なら Contents: Read and write）
GITHUB_PRESENCE_TOKEN=
# 監視スイッチを格納するリポジトリとブランチ（既定: Densyakun/opencode-workspace の presence ブランチ）
# GITHUB_PRESENCE_REPO=Densyakun/opencode-workspace
# GITHUB_PRESENCE_BRANCH=presence
# 以下はダッシュボードからは使用しない任意設定です。
# opencode は Codespace 内（.devcontainer の postStartCommand）で自動起動し、
# プロバイダーの認証は Codespace 内で `opencode auth login` により行います。
# ポート公開(public)する場合は、Codespaceの .devcontainer 側で Basic 認証を設定してください。
# OPENCODE_API_KEY=
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=