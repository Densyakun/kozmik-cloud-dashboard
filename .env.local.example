# PORT=3000 # ローカルでポート競合時のみ指定（既定3000）。Vercelでは不要
GITHUB_CODESPACES_TOKEN=
ONA_PERSONAL_ACCESS_TOKEN=
# Ona/Gitpod APIのドメイン（組織ごとに異なる場合に指定。既定は https://app.ona.com で308リダイレクトに自動追従）
ONA_API_HOST=https://app.gitpod.io
OPENCODE_API_KEY=
# OpenCode serve のユーザー名（未設定なら「opencode」）
OPENCODE_SERVER_USERNAME=opencode
# 未設定の場合は起動のたびに自動生成されます
OPENCODE_SERVER_PASSWORD=
